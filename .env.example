# Kingsley Portfolio — environment
# Copy to .env.local for development. Never commit real secrets.

# CockroachDB / Postgres — shares the Bespoke Technologies cluster.
DATABASE_URL="postgresql://user:password@host:26257/defaultdb?sslmode=verify-full"

# 32+ character session secret for admin auth.
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Object storage — shares the Bespoke Technologies R2 bucket.
S3_BUCKET="bespoke-technologies"
S3_REGION="auto"
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_PUBLIC_BASE_URL=""

# Public site URL.
NEXT_PUBLIC_SITE_URL="https://kingsley.bespoketech.com"
